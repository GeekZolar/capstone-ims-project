# Backend now supports CORS; call directly.
VITE_API_BASE_URL=http://localhost:3001/api/v1

# Authentication (VITE_ prefix required for client-side use)
VITE_LOGIN_ENDPOINT=/auth/login
VITE_VERIFY_LOGIN_ENDPOINT=/auth/mfa/verify-login
VITE_REGISTRATION_ROLES_ENDPOINT=/roles/registration
VITE_SUPPLIERS_ENDPOINT=/utility/suppliers
VITE_COUNTRIES_ENDPOINT=/utility/countries
VITE_WAREHOUSES_ENDPOINT=/utility/warehouses
VITE_PRODUCTS_ENDPOINT=/utility/products
VITE_USERS_ENDPOINT=/users
VITE_USERS_CREATE_ENDPOINT=/users/create
# MFA settings (VITE_ required for client-side; non-prefixed kept for tooling)
VITE_MFA_SETUP_ENDPOINT=/auth/mfa/setup
VITE_MFA_VERIFY_ENDPOINT=/auth/mfa/verify
MFA_SETUP_ENDPOINT=/auth/mfa/setup
MFA_VERIFY_ENDPOINT=/auth/mfa/verify
MFA_DISABLE_ENDPOINT=/auth/mfa/verify-disable
LOGOUT_ENDPOINT=/auth/logout
PASSWORD_RESET_REQUEST_ENDPOINT=/auth/password-reset/request
PASSWORD_RESET_VERIFY_ENDPOINT=/auth/password-reset/confirm
